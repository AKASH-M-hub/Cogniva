    },
    {
      "parameters": {
        "jsCode": "const data = $json;\n\nconst report = `\n<h2>Cogniva Weekly Analytics Report</h2>\n\n<p>Hello ${data.name},</p>\n\n<p>Here is your weekly Cogniva analytics report.</p>\n\n<hr>\n\n<h3>Your Activity</h3>\n\n<ul>\n  <li><strong>Department:</strong> ${data.department}</li>\n  <li><strong>Queries:</strong> ${data.weekly_queries}</li>\n  <li><strong>AI Responses:</strong> ${data.weekly_responses}</li>\n  <li><strong>Sessions:</strong> ${data.weekly_sessions}</li>\n  <li><strong>Report Period:</strong> ${data.timeframe}</li>\n</ul>\n\n<hr>\n\n<p>This report was generated automatically by Cogniva.</p>\n`;\n\nreturn {\n  json: {\n    ...data,\n    report: report,\n    report_period: data.timeframe\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        976,
        -16
      ],
      "id": "aecaf83c-f255-4846-912d-319510659960",
      "name": "Generate Weekly Report"
    },
    {
      "parameters": {
        "fromEmail": "akashmohanraj333@gmail.com",
        "toEmail": "={{ $json.email }}",
        "subject": "=Cogniva Weekly Analytics Report - {{ $json.report_period }}",
        "html": "={{ $json.report }}",
        "options": {}
      },
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
